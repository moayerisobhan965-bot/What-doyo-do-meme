# Application Settings
APP_NAME=What Meme
APP_ENV=production
DEBUG=false
VERSION=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Settings (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/whatmeme
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Settings
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# JWT Settings
JWT_SECRET_KEY=change_this_to_a_very_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Email Settings (Resend/Brevo)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_resend_api_key_here
SMTP_FROM=noreply@whatmeme.de
SMTP_FROM_NAME=What Meme

# WICHTIG: Backend Domain für E-Mail Links
BACKEND_DOMAIN=whatmeme.de

# Email Verification
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_BURST=10

# Game Settings
MAX_PLAYERS_PER_ROOM=10
MIN_PLAYERS_TO_START=2
WIN_SCORE=5
MAX_CAPTIONS_PER_ROUND=5
MAX_GAME_DURATION_MINUTES=30

# CORS
CORS_ORIGINS=https://whatmeme.de,http://localhost:3000

# Meme Settings
MEME_STORAGE_PATH=/app/static/memes
MEME_DOWNLOAD_DELAY=0.1

# SSL/HTTPS
ENABLE_SSL=true
SSL_CERT_PATH=/etc/letsencrypt/live/whatmeme.de/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/whatmeme.de/privkey.pem

# Monitoring
LOG_LEVEL=INFO
ENABLE_HEALTH_CHECK=true
